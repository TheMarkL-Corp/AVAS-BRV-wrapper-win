<UserControl x:Class="AvasRoutingApp.Views.EncoderCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="260" d:DesignWidth="350">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Border Background="{DynamicResource ThemeCardBackgroundBrush}" BorderBrush="{DynamicResource ThemeCardBorderBrush}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,12" Padding="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Card Header: Device Name & Link Mode Badge (Minimalist) -->
            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                <!-- Right: Segmented Chip Toggle & Link Mode Badge -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <!-- Single Link Chip 0 / Chip 1 Toggle (Only visible if CanSelectChip1 is true) -->
                    <Border Visibility="{Binding CanSelectChip1, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Background="#0F172A"
                            BorderBrush="#334155"
                            BorderThickness="1"
                            CornerRadius="4"
                            Margin="0,0,8,0"
                            Padding="2">
                        <StackPanel Orientation="Horizontal">
                            <!-- Chip 0 Button -->
                            <Button Command="{Binding SelectChip0Command}"
                                    Content="Chip 0"
                                    FontSize="10"
                                    FontWeight="SemiBold"
                                    Padding="6,2"
                                    BorderThickness="0"
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="#94A3B8"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChip0Selected}" Value="True">
                                                <Setter Property="Background" Value="#2563EB"/>
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <!-- Chip 1 Button -->
                            <Button Command="{Binding SelectChip1Command}"
                                    Content="Chip 1"
                                    FontSize="10"
                                    FontWeight="SemiBold"
                                    Padding="6,2"
                                    BorderThickness="0"
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="#94A3B8"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChip1Selected}" Value="True">
                                                <Setter Property="Background" Value="#2563EB"/>
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Link Mode Badge (Single Link / Dual Link) -->
                    <Border Background="{Binding LinkModeBrush}"
                            CornerRadius="4"
                            Padding="7,2"
                            VerticalAlignment="Center"
                            Visibility="{Binding ShowLinkModeBadge, Converter={StaticResource BoolToVisConverter}}">
                        <TextBlock Text="{Binding LinkModeBadgeText}" Foreground="White" FontSize="10" FontWeight="Bold" />
                    </Border>
                </StackPanel>

                <!-- Left: Device Name & Status Dot -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="●" Foreground="{DynamicResource ThemeAccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center" FontSize="10" />
                    <TextBlock Text="{Binding DeviceName}" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="280" />
                </StackPanel>
            </DockPanel>

            <!-- Video Viewport: Image bound to WriteableBitmap with 16:9 proportional scaling -->
            <Border Grid.Row="1" Background="{DynamicResource ThemeVideoBackgroundBrush}" CornerRadius="4" ClipToBounds="True" BorderBrush="{DynamicResource ThemeCardBorderBrush}" BorderThickness="1" MinHeight="180">
                <Grid MinHeight="180">
                    <!-- Live Decoded Video Viewport -->
                    <Image Source="{Binding PreviewBitmap}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" MaxHeight="380" />

                    <!-- Resolution & Live Overlay Badge -->
                    <Border Background="{DynamicResource ThemeSurfaceOverlayBrush}" CornerRadius="3" Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="{Binding FpsBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Resolution, Mode=OneWay}" Foreground="White" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Waiting / Connecting Overlay -->
                    <Border Background="{DynamicResource ThemeSurfaceOverlayBrush}" Visibility="{Binding IsWaitingForStream, Converter={StaticResource BoolToVisConverter}}"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Path Data="{DynamicResource IconGeometrySignal}" Fill="{DynamicResource ThemeAccentBrush}" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,6" />
                            <TextBlock Text="CONNECTING..." Foreground="{DynamicResource ThemeAccentBrush}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource ThemeTextSecondaryBrush}" FontSize="10" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Card Footer: Minimalist 2-line Telemetry & Live Color-Coded FPS Indicator -->
            <Grid Grid.Row="2" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Telemetry Details (IP and MAC with Quick Copy) -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <!-- Line 1: IP -->
                    <TextBlock Foreground="{DynamicResource ThemeTextSecondaryBrush}" FontSize="10" Margin="0,0,0,3" TextTrimming="CharacterEllipsis">
                        <Run Text="IP: " FontWeight="SemiBold" /><Run Text="{Binding UnicastIp, Mode=OneWay}" Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontFamily="Consolas, Courier New" />
                    </TextBlock>

                    <!-- Line 2: MAC with quick copy button -->
                    <DockPanel LastChildFill="False" VerticalAlignment="Center">
                        <TextBlock Foreground="{DynamicResource ThemeTextSecondaryBrush}" FontSize="10" VerticalAlignment="Center">
                            <Run Text="MAC: " FontWeight="SemiBold" /><Run Text="{Binding MacAddress, Mode=OneWay}" Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontFamily="Consolas, Courier New" />
                        </TextBlock>
                        <Button Command="{Binding CopyMacCommand}" Background="{DynamicResource ThemePillBackgroundBrush}" BorderThickness="1" BorderBrush="{DynamicResource ThemeCardBorderBrush}" Padding="6,2" Margin="8,0,0,0" Cursor="Hand" ToolTip="Copy MAC Address" MinHeight="22" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{DynamicResource IconGeometryCopy}" Fill="{DynamicResource ThemeTextMutedBrush}" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center" />
                                <TextBlock Text=" Copied!" Foreground="{DynamicResource ThemeStatusOnlineBrush}" FontSize="9" FontWeight="Bold" Visibility="{Binding IsMacCopied, Converter={StaticResource BoolToVisConverter}}" />
                            </StackPanel>
                        </Button>
                    </DockPanel>
                </StackPanel>

                <!-- Right: Visual Color-Coded Live FPS Badge (Green >= 1.0, Amber < 1.0) -->
                <Border Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="4" Padding="8,4" Background="{DynamicResource ThemePillBackgroundBrush}" BorderThickness="1" BorderBrush="{DynamicResource ThemeCardBorderBrush}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{Binding FpsBrush}" />
                        <TextBlock Text="{Binding FpsDisplay}" Foreground="{Binding FpsBrush}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
