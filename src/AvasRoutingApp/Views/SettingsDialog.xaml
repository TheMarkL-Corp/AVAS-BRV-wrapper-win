<Window x:Class="AvasRoutingApp.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings — AVAS Routing SW"
        Height="620" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1E1E24"
        Foreground="#EDF2F4">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#EDF2F4" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="HeaderLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#4895EF" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>

        <Style x:Key="SubLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8D99AE" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#14151B" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#3D405B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#4895EF" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2B2D42" />
            <Setter Property="Foreground" Value="#EDF2F4" />
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#3D405B" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="Configuration &amp; Network Settings" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,12" />

        <!-- Form ScrollViewer -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,8,0">
                <!-- BlueRiver AV Manager Section -->
                <TextBlock Text="BlueRiver AV Manager Web Interface" Style="{StaticResource HeaderLabelStyle}" />
                <TextBlock Text="URL for embedding the BlueRiver AV Manager web interface:" />
                <TextBox x:Name="TxtBlueRiverUrl" Text="http://localhost:3000" />

                <!-- SDVoE Control Server Section -->
                <TextBlock Text="SDVoE Control Server" Style="{StaticResource HeaderLabelStyle}" />
                <TextBlock Text="Control Server Host / IP Address:" />
                <TextBox x:Name="TxtControlServerIp" Text="127.0.0.1" />

                <Grid Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="REST API Port:" />
                        <TextBox x:Name="TxtRestPort" Text="8080" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Telnet TCP Port:" />
                        <TextBox x:Name="TxtTelnetPort" Text="6970" />
                    </StackPanel>
                </Grid>

                <!-- Multicast Allocation Pool Section -->
                <TextBlock Text="Multicast IP Allocation Pool" Style="{StaticResource HeaderLabelStyle}" />
                <TextBlock Text="Dynamic IP range allocated to AVAS-223 chip_0 preview streams:" Style="{StaticResource SubLabelStyle}" />

                <Grid Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Start Multicast IP:" />
                        <TextBox x:Name="TxtMulticastStartIp" Text="224.1.1.1" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="End Multicast IP:" />
                        <TextBox x:Name="TxtMulticastEndIp" Text="224.1.3.225" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="Multicast Base Port:" />
                <TextBox x:Name="TxtBasePort" Text="6792" />

                <!-- Local Network Interface -->
                <TextBlock Text="Local Network Interface" Style="{StaticResource HeaderLabelStyle}" />
                <TextBlock Text="Bind to specific local IP (leave empty for default interface):" Style="{StaticResource SubLabelStyle}" />
                <TextBox x:Name="TxtLocalNetworkInterfaceIp" Text="" />
            </StackPanel>
        </ScrollViewer>

        <!-- Validation Errors Box -->
        <Border Grid.Row="2" x:Name="BorderErrors" Background="#3B1218" BorderBrush="#D90429" BorderThickness="1" CornerRadius="3" Padding="8" Margin="0,8,0,8" Visibility="Collapsed">
            <TextBlock x:Name="TxtErrors" Foreground="#FF8585" TextWrapping="Wrap" FontSize="11" />
        </Border>

        <!-- Dialog Buttons -->
        <DockPanel Grid.Row="3" Margin="0,8,0,0">
            <Button Content="Reset Defaults" Click="BtnResetDefaults_Click" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Click="BtnCancel_Click" Style="{StaticResource SecondaryButtonStyle}" IsCancel="True" />
                <Button Content="Save Settings" Click="BtnSave_Click" Style="{StaticResource PrimaryButtonStyle}" IsDefault="True" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
