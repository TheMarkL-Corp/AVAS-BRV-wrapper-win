<Window x:Class="AvasRoutingApp.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings — AVAS Routing Software"
        Height="700" Width="550"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource ThemeWindowBackgroundBrush}"
        Foreground="{DynamicResource ThemeTextPrimaryBrush}">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="HeaderLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>

        <Style x:Key="SubLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondaryBrush}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource ThemeInputBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeInputForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeInputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="ComboBoxToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ClickMode" Value="Press" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="TemplateRoot"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <Border x:Name="SplitBorder"
                                    Width="34"
                                    Margin="0"
                                    HorizontalAlignment="Right"
                                    BorderThickness="0">
                                <Path x:Name="Arrow"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Data="M 0 0 L 5 5 L 10 0 Z"
                                      Fill="{DynamicResource ThemeTextSecondaryBrush}" />
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TemplateRoot" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
                                <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource ThemeAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TemplateRoot" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
                                <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource ThemeAccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Background" Value="{DynamicResource ThemeInputBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeInputForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeInputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="MainGrid" SnapsToDevicePixels="True">
                            <ToggleButton x:Name="ToggleButton"
                                          Style="{StaticResource ComboBoxToggleButtonStyle}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="False"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press" />
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="10,6,36,6"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left" />
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="{DynamicResource ThemeCardBackgroundBrush}"
                                            BorderBrush="{DynamicResource ThemeInputBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="3"
                                            Margin="0,2,0,0">
                                        <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="4"
                                Margin="1,2">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource ThemeButtonHoverBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource ThemeAccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource ThemeAccentForegroundBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeAccentForegroundBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeButtonBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeButtonForegroundBrush}" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeButtonBorderBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource ThemeButtonHoverBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title & App Info -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                <Image x:Name="ImgSettingsLogo" Width="22" Height="22" Margin="0,0,8,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="Configuration &amp; Network Settings" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" VerticalAlignment="Center" />
            </StackPanel>
            <Border DockPanel.Dock="Right" HorizontalAlignment="Right" Background="{DynamicResource ThemePillBackgroundBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                <TextBlock x:Name="TxtSettingsAppVersion" Text="v1.3.0" FontSize="11" Foreground="{DynamicResource ThemeAccentBrush}" FontWeight="Bold" />
            </Border>
        </DockPanel>

        <!-- Form ScrollViewer with Grouped Cards -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly" IsDeferredScrollingEnabled="False">
            <StackPanel Margin="0,0,8,0">
                <!-- Group 1: Appearance & Web Interface -->
                <Border Background="{DynamicResource ThemeCardBackgroundBrush}" BorderBrush="{DynamicResource ThemeCardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Web Interface &amp; Appearance" Style="{StaticResource HeaderLabelStyle}" Margin="0,0,0,4" />
                        <TextBlock Text="Configure web matrix embedding URL and visual theme" Style="{StaticResource SubLabelStyle}" Margin="0,0,0,10" />

                        <TextBlock Text="Application Theme:" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,4" />
                        <ComboBox x:Name="CmbTheme" SelectedIndex="0" Margin="0,0,0,12">
                            <ComboBoxItem Content="Light Mode (Advantech Blue / Crisp Gray)" Tag="Light" />
                            <ComboBoxItem Content="Dark Mode (Advantech Blue / Charcoal)" Tag="Dark" />
                        </ComboBox>

                        <TextBlock Text="BlueRiver AV Manager Web URL:" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,4" />
                        <TextBox x:Name="TxtBlueRiverUrl" Text="http://localhost:80" />
                    </StackPanel>
                </Border>

                <!-- Group 2: SDVoE Control Server -->
                <Border Background="{DynamicResource ThemeCardBackgroundBrush}" BorderBrush="{DynamicResource ThemeCardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="SDVoE Control Server" Style="{StaticResource HeaderLabelStyle}" Margin="0" VerticalAlignment="Center" />
                            <!-- Inline Connection Test Button with Touch Target -->
                            <Button x:Name="BtnTestConnection" Content="Test Connection" Click="BtnTestConnection_Click" 
                                    DockPanel.Dock="Right" HorizontalAlignment="Right" 
                                    Background="{DynamicResource ThemeButtonBackgroundBrush}" Foreground="{DynamicResource ThemeButtonForegroundBrush}" 
                                    BorderBrush="{DynamicResource ThemeButtonBorderBrush}" BorderThickness="1" 
                                    MinHeight="34" Padding="14,6" FontSize="11" FontWeight="SemiBold" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource ThemeButtonHoverBackgroundBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="Border" Property="Opacity" Value="0.75" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DockPanel>
                        <TextBlock Text="Parameters for the primary SDVoE API controller" Style="{StaticResource SubLabelStyle}" Margin="0,0,0,10" />

                        <!-- Connection Test Result Banner -->
                        <TextBlock x:Name="TxtTestResult" Text="" FontSize="11" FontWeight="SemiBold" Visibility="Collapsed" Margin="0,0,0,8" />

                        <TextBlock Text="Server Host / IP Address:" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,4" />
                        <TextBox x:Name="TxtControlServerIp" Text="127.0.0.1" />

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="REST API Port:" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,4" />
                                <TextBox x:Name="TxtRestPort" Text="8090" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Telnet TCP Port:" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,4" />
                                <TextBox x:Name="TxtTelnetPort" Text="6970" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Group 3: Multicast Allocation & Network Interface -->
                <Border Background="{DynamicResource ThemeCardBackgroundBrush}" BorderBrush="{DynamicResource ThemeCardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Multicast Allocation &amp; Local Network" Style="{StaticResource HeaderLabelStyle}" Margin="0,0,0,4" />
                        <TextBlock Text="Dynamic multicast IP range for AVAS-223 chip_0 preview streams" Style="{StaticResource SubLabelStyle}" Margin="0,0,0,10" />

                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Start Multicast IP:" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,4" />
                                <TextBox x:Name="TxtMulticastStartIp" Text="224.1.3.1" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="End Multicast IP:" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,4" />
                                <TextBox x:Name="TxtMulticastEndIp" Text="224.1.3.225" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Multicast Base Port:" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,4,0,4" />
                        <TextBox x:Name="TxtBasePort" Text="5000" />

                        <TextBlock Text="Local Network Interface Binding (optional):" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,4,0,4" />
                        <TextBox x:Name="TxtLocalNetworkInterfaceIp" Text="" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Validation Errors Box -->
        <Border Grid.Row="2" x:Name="BorderErrors" Background="{DynamicResource ThemeStatusErrorBackgroundBrush}" BorderBrush="{DynamicResource ThemeStatusErrorBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,8,0,8" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <Path Data="{DynamicResource IconGeometryWarning}" Fill="{DynamicResource ThemeStatusErrorBrush}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Top" />
                <TextBlock x:Name="TxtErrors" Foreground="{DynamicResource ThemeStatusErrorBrush}" FontWeight="SemiBold" TextWrapping="Wrap" FontSize="11" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Dialog Buttons -->
        <DockPanel Grid.Row="3" Margin="0,8,0,0">
            <Button Content="Reset Defaults" Click="BtnResetDefaults_Click" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Click="BtnCancel_Click" Style="{StaticResource SecondaryButtonStyle}" IsCancel="True" />
                <Button Content="Save Settings" Click="BtnSave_Click" Style="{StaticResource PrimaryButtonStyle}" IsDefault="True" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
