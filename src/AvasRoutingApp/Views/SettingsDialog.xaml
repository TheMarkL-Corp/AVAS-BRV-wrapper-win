<Window x:Class="AvasRoutingApp.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings — AVAS Routing Software"
        Height="660" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource ThemeWindowBackgroundBrush}"
        Foreground="{DynamicResource ThemeTextPrimaryBrush}">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="HeaderLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>

        <Style x:Key="SubLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondaryBrush}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource ThemeInputBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeInputForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeInputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource ThemeInputBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeInputForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeInputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeAccentForegroundBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeButtonBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeButtonForegroundBrush}" />
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeButtonBorderBrush}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title & App Info -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                <Image x:Name="ImgSettingsLogo" Width="22" Height="22" Margin="0,0,8,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="Configuration &amp; Network Settings" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" VerticalAlignment="Center" />
            </StackPanel>
            <Border DockPanel.Dock="Right" HorizontalAlignment="Right" Background="{DynamicResource ThemePillBackgroundBrush}" CornerRadius="3" Padding="6,2" VerticalAlignment="Center">
                <TextBlock Text="v1.0.0" FontSize="11" Foreground="{DynamicResource ThemeAccentBrush}" FontWeight="Bold" />
            </Border>
        </DockPanel>

        <!-- Form ScrollViewer -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,8,0">
                <!-- Appearance / Theme Section -->
                <TextBlock Text="Appearance &amp; Theme" Style="{StaticResource HeaderLabelStyle}" />
                <TextBlock Text="Select application theme (seamless with BlueRiver AV Manager):" Style="{StaticResource SubLabelStyle}" />
                <ComboBox x:Name="CmbTheme" SelectedIndex="0">
                    <ComboBoxItem Content="Dark Mode (Advantech Blue / Charcoal)" Tag="Dark" />
                    <ComboBoxItem Content="Light Mode (Advantech Blue / Crisp Gray)" Tag="Light" />
                </ComboBox>

                <!-- BlueRiver AV Manager Section -->
                <TextBlock Text="BlueRiver AV Manager Web Interface" Style="{StaticResource HeaderLabelStyle}" />
                <TextBlock Text="URL for embedding the BlueRiver AV Manager web interface:" />
                <TextBox x:Name="TxtBlueRiverUrl" Text="http://localhost:3000" />

                <!-- SDVoE Control Server Section -->
                <TextBlock Text="SDVoE Control Server" Style="{StaticResource HeaderLabelStyle}" />
                <TextBlock Text="Control Server Host / IP Address:" />
                <TextBox x:Name="TxtControlServerIp" Text="127.0.0.1" />

                <Grid Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="REST API Port:" />
                        <TextBox x:Name="TxtRestPort" Text="8080" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Telnet TCP Port:" />
                        <TextBox x:Name="TxtTelnetPort" Text="6970" />
                    </StackPanel>
                </Grid>

                <!-- Multicast Allocation Pool Section -->
                <TextBlock Text="Multicast IP Allocation Pool" Style="{StaticResource HeaderLabelStyle}" />
                <TextBlock Text="Dynamic IP range allocated to AVAS-223 chip_0 preview streams:" Style="{StaticResource SubLabelStyle}" />

                <Grid Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Start Multicast IP:" />
                        <TextBox x:Name="TxtMulticastStartIp" Text="224.1.1.1" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="End Multicast IP:" />
                        <TextBox x:Name="TxtMulticastEndIp" Text="224.1.3.225" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="Multicast Base Port:" />
                <TextBox x:Name="TxtBasePort" Text="5000" />

                <!-- Local Network Interface -->
                <TextBlock Text="Local Network Interface" Style="{StaticResource HeaderLabelStyle}" />
                <TextBlock Text="Bind to specific local IP (leave empty for default interface):" Style="{StaticResource SubLabelStyle}" />
                <TextBox x:Name="TxtLocalNetworkInterfaceIp" Text="" />
            </StackPanel>
        </ScrollViewer>

        <!-- Validation Errors Box -->
        <Border Grid.Row="2" x:Name="BorderErrors" Background="#3B1218" BorderBrush="#D90429" BorderThickness="1" CornerRadius="3" Padding="8" Margin="0,8,0,8" Visibility="Collapsed">
            <TextBlock x:Name="TxtErrors" Foreground="#FF8585" TextWrapping="Wrap" FontSize="11" />
        </Border>

        <!-- Dialog Buttons -->
        <DockPanel Grid.Row="3" Margin="0,8,0,0">
            <Button Content="Reset Defaults" Click="BtnResetDefaults_Click" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Click="BtnCancel_Click" Style="{StaticResource SecondaryButtonStyle}" IsCancel="True" />
                <Button Content="Save Settings" Click="BtnSave_Click" Style="{StaticResource PrimaryButtonStyle}" IsDefault="True" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
