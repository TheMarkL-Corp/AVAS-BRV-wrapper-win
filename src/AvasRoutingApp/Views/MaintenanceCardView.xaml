<UserControl x:Class="AvasRoutingApp.Views.MaintenanceCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="180" d:DesignWidth="360">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </UserControl.Resources>

    <Border Background="{DynamicResource ThemeCardBackgroundBrush}" 
            BorderBrush="{DynamicResource ThemeCardBorderBrush}" 
            BorderThickness="1" 
            CornerRadius="8" 
            Margin="0,0,0,10" 
            Padding="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Header: Type, Name, Link Badge -->
                <RowDefinition Height="Auto" /> <!-- Telemetry & Network Details Box -->
                <RowDefinition Height="Auto" /> <!-- Action Row: Open Diag Button -->
            </Grid.RowDefinitions>

            <!-- 1. Header: Type Badge (TX/RX), Name, Link Badge -->
            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Border Background="{Binding DeviceTypeBrush}" CornerRadius="3" Padding="6,2" Margin="0,0,6,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DeviceTypeBadge}" Foreground="White" FontSize="10" FontWeight="Bold" />
                    </Border>
                    <TextBlock Text="{Binding DeviceName}" 
                               FontWeight="Bold" 
                               Foreground="{DynamicResource ThemeTextPrimaryBrush}" 
                               FontSize="13" 
                               VerticalAlignment="Center" 
                               TextTrimming="CharacterEllipsis" 
                               MaxWidth="200" 
                               ToolTip="{Binding DeviceName}" />
                </StackPanel>

                <Border DockPanel.Dock="Right" HorizontalAlignment="Right" Background="{Binding LinkModeBrush}" CornerRadius="3" Padding="6,2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding LinkMode}" Foreground="White" FontSize="9" FontWeight="Bold" />
                </Border>
            </DockPanel>

            <!-- 2. Telemetry Box -->
            <Border Grid.Row="1" Background="{DynamicResource ThemeCardHeaderBackgroundBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,0,10" BorderThickness="1" BorderBrush="{DynamicResource ThemeCardBorderBrush}">
                <StackPanel>
                    <!-- Primary Chip 0 MAC and IP -->
                    <DockPanel Margin="0,0,0,4">
                        <Button Command="{Binding CopyMacCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="0" VerticalAlignment="Center" ToolTip="Click to copy MAC">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="MAC: " Foreground="{DynamicResource ThemeTextMutedBrush}" FontSize="11" />
                                <TextBlock Text="{Binding MacAddress}" Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontSize="11" FontFamily="Consolas, Courier New" FontWeight="SemiBold" />
                                <Path Data="{DynamicResource IconGeometryCopy}" Fill="{DynamicResource ThemeTextMutedBrush}" Width="9" Height="9" Stretch="Uniform" Margin="4,0,0,0" VerticalAlignment="Center" />
                                <TextBlock Text="Copied!" Foreground="{DynamicResource ThemeStatusOnlineBrush}" FontSize="9" FontWeight="Bold" Margin="4,0,0,0" Visibility="{Binding IsMacCopied, Converter={StaticResource BoolToVisConverter}}" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{Binding IpAddress}" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="{DynamicResource ThemeTextMutedBrush}" FontSize="10" VerticalAlignment="Center" FontFamily="Consolas, Courier New" />
                    </DockPanel>

                    <!-- Companion Chip 1 (if available) -->
                    <DockPanel Visibility="{Binding HasCompanion, Converter={StaticResource BoolToVisConverter}}" Margin="0,2,0,0">
                        <TextBlock Foreground="{DynamicResource ThemeTextMutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis">
                            <Run Text="Companion: " />
                            <Run Text="{Binding CompanionMac, Mode=OneWay}" Foreground="{DynamicResource ThemeTextSecondaryBrush}" FontFamily="Consolas, Courier New" />
                        </TextBlock>
                        <TextBlock Text="Chip 1" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="{DynamicResource ThemeTextMutedBrush}" FontSize="9" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- 3. Actions Row: Prominent Diagnostics Button -->
            <DockPanel Grid.Row="2">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="AVAS-223 Endpoint" Foreground="{DynamicResource ThemeTextMutedBrush}" FontSize="10" VerticalAlignment="Center" />
                </StackPanel>

                <Button DockPanel.Dock="Right" HorizontalAlignment="Right"
                        Command="{Binding OpenDiagnosticsCommand}"
                        Background="{DynamicResource ThemeTabActiveBackgroundBrush}"
                        BorderBrush="{DynamicResource ThemeAccentBrush}"
                        BorderThickness="1"
                        Padding="12,5"
                        MinHeight="28"
                        Cursor="Hand"
                        ToolTip="Open AVAS Hardware Diagnostics and Reset Controls">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Opacity" Value="1.0" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="0.9" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Opacity" Value="0.75" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{DynamicResource IconGeometrySettings}" Fill="{DynamicResource ThemeAccentBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Hardware Diagnostics" Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </DockPanel>
        </Grid>
    </Border>
</UserControl>
