<UserControl x:Class="AvasRoutingApp.Views.MultiLinkCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="280" d:DesignWidth="360">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </UserControl.Resources>

    <Border Background="{DynamicResource ThemeCardBackgroundBrush}" 
            BorderBrush="{DynamicResource ThemeCardBorderBrush}" 
            BorderThickness="1" 
            CornerRadius="8" 
            Margin="0,0,0,12" 
            Padding="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Header -->
                <RowDefinition Height="Auto" /> <!-- Telemetry & Companion -->
                <RowDefinition Height="Auto" /> <!-- Mode Segmented Switch -->
                <RowDefinition Height="Auto" /> <!-- Reboot Progress Panel -->
            </Grid.RowDefinitions>

            <!-- 1. Header: Primary Device Name & Mode Badge -->
            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="●" Foreground="{DynamicResource ThemeAccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center" FontSize="11" />
                    <TextBlock Text="{Binding PrimaryName}" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="190" />
                </StackPanel>
                
                <Border DockPanel.Dock="Right" HorizontalAlignment="Right" Background="{Binding LinkModeBrush}" CornerRadius="4" Padding="7,2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding LinkModeBadgeText}" Foreground="White" FontSize="10" FontWeight="Bold" />
                </Border>
            </DockPanel>

            <!-- 2. Primary Telemetry & Companion Status Box -->
            <Border Grid.Row="1" Background="{DynamicResource ThemeCardHeaderBackgroundBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,0,12" BorderThickness="1" BorderBrush="{DynamicResource ThemeCardBorderBrush}">
                <StackPanel>
                    <!-- Primary MAC & IP -->
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock Foreground="{DynamicResource ThemeTextSecondaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis">
                            <Run Text="Primary (chip_0): " FontWeight="SemiBold" />
                            <Run Text="{Binding PrimaryMac, Mode=OneWay}" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                        </TextBlock>
                        <TextBlock Text="{Binding PrimaryIp, Mode=OneWay}" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="{DynamicResource ThemeTextMutedBrush}" FontSize="10" VerticalAlignment="Center" />
                    </DockPanel>

                    <Separator Background="{DynamicResource ThemeCardBorderBrush}" Margin="0,4,0,6" />

                    <!-- Companion Box -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Companion MAC / Name -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="SFP+ B Companion (chip_1):" Foreground="{DynamicResource ThemeTextSecondaryBrush}" FontSize="10" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding CompanionDisplayTitle, Mode=OneWay}" Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                        </StackPanel>

                        <!-- Right: Companion Status Pill -->
                        <Border Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Background="{DynamicResource ThemePillBackgroundBrush}" CornerRadius="4" Padding="6,3" BorderThickness="1" BorderBrush="{DynamicResource ThemeCardBorderBrush}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="7" Height="7" Fill="{Binding CompanionStatusBrush}" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding CompanionStatusText}" Foreground="{Binding CompanionStatusBrush}" FontWeight="Bold" FontSize="10" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 3. Multi-Link Mode Segmented Switch -->
            <Grid Grid.Row="2" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="MULTI-LINK MODE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ThemeTextMutedBrush}" />
                    <TextBlock Text="Switch between 10G and 20G" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,1,0,0" />
                </StackPanel>

                <!-- iOS-Style Segmented Mode Switch Container -->
                <Border Grid.Column="1" Background="{DynamicResource ThemePillBackgroundBrush}" BorderBrush="{DynamicResource ThemeCardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="3">
                    <StackPanel Orientation="Horizontal">
                        <!-- SINGLE Button -->
                        <Button Content="SINGLE" 
                                Command="{Binding SetSingleModeCommand}"
                                Width="68" Height="26" 
                                FontSize="10" FontWeight="Bold" 
                                Cursor="Hand"
                                BorderThickness="0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSingleLinkSelected}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource ThemeBadgeSingleBackgroundBrush}" />
                                            <Setter Property="Foreground" Value="White" />
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="0.85" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- DUAL Button -->
                        <Button Content="DUAL" 
                                Command="{Binding SetDualModeCommand}"
                                Width="68" Height="26" 
                                FontSize="10" FontWeight="Bold" 
                                Cursor="Hand"
                                BorderThickness="0"
                                Margin="2,0,0,0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDualLinkSelected}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource ThemeBadgeDualBackgroundBrush}" />
                                            <Setter Property="Foreground" Value="White" />
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="0.85" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 4. Non-Blocking 20-Second Reboot Progress Panel -->
            <Border Grid.Row="3" 
                    Visibility="{Binding IsRebooting, Converter={StaticResource BoolToVisConverter}}"
                    Background="{DynamicResource ThemeCardHeaderBackgroundBrush}" 
                    BorderBrush="{DynamicResource ThemeAccentBrush}" 
                    BorderThickness="1" 
                    CornerRadius="6" 
                    Padding="10,8" 
                    Margin="0,8,0,0">
                <StackPanel>
                    <DockPanel>
                        <TextBlock Text="🔄 Hardware Rebooting..." FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontSize="11" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding RebootStatusMessage}" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="{DynamicResource ThemeAccentBrush}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" />
                    </DockPanel>

                    <ProgressBar Height="6" 
                                 Margin="0,6,0,0" 
                                 Minimum="0" 
                                 Maximum="20" 
                                 Value="{Binding RebootProgress}" 
                                 Foreground="{DynamicResource ThemeAccentBrush}" 
                                 Background="{DynamicResource ThemePillBackgroundBrush}" 
                                 BorderThickness="0" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
