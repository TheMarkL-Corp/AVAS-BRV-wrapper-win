<Window x:Class="AvasRoutingApp.Views.MaintenanceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AvasRoutingApp.ViewModels"
        Title="Device Maintenance &amp; Diagnostics — AVAS"
        Height="560" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource ThemeWindowBackgroundBrush}"
        Foreground="{DynamicResource ThemeTextPrimaryBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: Title and Device Info -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                <Border Background="{DynamicResource ThemePillBackgroundBrush}" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                    <TextBlock Text="{Binding LinkMode, StringFormat='Mode: {0}'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeAccentBrush}" />
                </Border>
            </StackPanel>
            
            <StackPanel Orientation="Vertical">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="3" Padding="5,1" Margin="0,0,6,0" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#3B82F6" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsReceiver}" Value="True">
                                        <Setter Property="Background" Value="#8B5CF6" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding DeviceTypeBadge}" Foreground="White" FontSize="10" FontWeight="Bold" />
                    </Border>
                    <TextBlock Text="AVAS Device Diagnostics" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Single Device Name display -->
                <TextBlock Text="{Binding DeviceName}" FontSize="12" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,2,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasMultipleDevices}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Multi-Device Switcher Dropdown -->
                <ComboBox ItemsSource="{Binding AvailableDevices}"
                          SelectedItem="{Binding SelectedDevice}"
                          Margin="0,4,0,0"
                          Height="26"
                          FontSize="11"
                          VerticalAlignment="Center">
                    <ComboBox.Style>
                        <Style TargetType="ComboBox">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasMultipleDevices}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.Style>
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Border CornerRadius="2" Padding="4,0" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#3B82F6" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsReceiver}" Value="True">
                                                    <Setter Property="Background" Value="#8B5CF6" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding DeviceName}" FontSize="9" FontWeight="Bold" Foreground="White">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="TX" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsReceiver}" Value="True">
                                                        <Setter Property="Text" Value="RX" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <TextBlock Text="{Binding DeviceName}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Text=" (" Foreground="{DynamicResource ThemeTextMutedBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding MacAddress}" FontFamily="Consolas, Courier New" Foreground="{DynamicResource ThemeTextSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Text=")" Foreground="{DynamicResource ThemeTextMutedBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </DockPanel>

        <!-- Section 1: Chip Target Selection -->
        <Border Grid.Row="1" Background="{DynamicResource ThemeCardBackgroundBrush}" BorderBrush="{DynamicResource ThemeCardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Target Silicon Selection" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource ThemeAccentBrush}" Margin="0,0,0,8" />
                <TextBlock Text="Select which AVP transceiver chip receives diagnostic and reset commands:" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,10" />

                <StackPanel Orientation="Vertical">
                    <!-- Chip 0 (Primary) -->
                    <RadioButton x:Name="RbChip0" GroupName="TargetChip" Margin="0,0,0,8" Checked="RbChip0_Checked" IsChecked="True">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Chip 0 (AVP0 Primary): " FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                            <TextBlock Text="{Binding Chip0Mac}" FontFamily="Consolas, Courier New" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
                        </StackPanel>
                    </RadioButton>

                    <!-- Chip 1 (Secondary Dual-Link) -->
                    <RadioButton x:Name="RbChip1" GroupName="TargetChip" Margin="0,0,0,8" Checked="RbChip1_Checked" IsEnabled="{Binding IsChip1Available}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Chip 1 (AVP1 Companion): " FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                            <TextBlock Text="{Binding Chip1Mac}" FontFamily="Consolas, Courier New" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
                            <TextBlock Text=" (Single-Link Only)" FontSize="10" Foreground="{DynamicResource ThemeTextMutedBrush}" Margin="6,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChip1Available}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </RadioButton>

                    <!-- Both Chips (Dual-Link) -->
                    <RadioButton x:Name="RbBoth" GroupName="TargetChip" Checked="RbBoth_Checked" IsEnabled="{Binding IsChip1Available}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Both Chips (Dual-Link Gang Reset): " FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                            <TextBlock Text="Chip 0 + Chip 1" FontFamily="Consolas, Courier New" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Section 2: Action Buttons -->
        <Border Grid.Row="2" Background="{DynamicResource ThemeCardBackgroundBrush}" BorderBrush="{DynamicResource ThemeCardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Maintenance Operations" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource ThemeAccentBrush}" Margin="0,0,0,8" />
                
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Factory Reset AVP -->
                    <Button Grid.Column="0" Content="Factory Reset (AVP)" Command="{Binding FactoryResetAvpCommand}"
                            Background="{DynamicResource ThemeButtonBackgroundBrush}" Foreground="{DynamicResource ThemeButtonForegroundBrush}"
                            BorderBrush="{DynamicResource ThemeButtonBorderBrush}" BorderThickness="1" MinHeight="36" FontWeight="SemiBold" FontSize="11" Cursor="Hand" />

                    <!-- MCU Factory Reset -->
                    <Button Grid.Column="2" Content="MCU Factory Reset" Command="{Binding FactoryResetMcuCommand}"
                            ToolTip="Sends 'set factory default' to MCU EEPROM via Chip 0 UART"
                            Background="{DynamicResource ThemeButtonBackgroundBrush}" Foreground="{DynamicResource ThemeButtonForegroundBrush}"
                            BorderBrush="{DynamicResource ThemeButtonBorderBrush}" BorderThickness="1" MinHeight="36" FontWeight="SemiBold" FontSize="11" Cursor="Hand" />

                    <!-- Reboot -->
                    <Button Grid.Column="4" Content="Reboot Silicon" Command="{Binding RebootCommand}"
                            Background="{DynamicResource ThemeButtonBackgroundBrush}" Foreground="{DynamicResource ThemeButtonForegroundBrush}"
                            BorderBrush="{DynamicResource ThemeButtonBorderBrush}" BorderThickness="1" MinHeight="36" FontWeight="SemiBold" FontSize="11" Cursor="Hand" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Section 3: Live Output Console Log -->
        <Border Grid.Row="3" Background="{DynamicResource ThemeInputBackgroundBrush}" BorderBrush="{DynamicResource ThemeCardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,12">
            <DockPanel>
                <TextBlock Text="Activity &amp; Diagnostics Log" DockPanel.Dock="Top" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,4" />
                <TextBox Text="{Binding StatusLog, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas, Courier New" FontSize="10" Foreground="{DynamicResource ThemeTextPrimaryBrush}" Background="Transparent" BorderThickness="0" />
            </DockPanel>
        </Border>

        <!-- Footer: Close Button -->
        <DockPanel Grid.Row="4">
            <Button Content="Close" Click="BtnClose_Click" IsCancel="True" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" MinWidth="90" MinHeight="32" />
        </DockPanel>
    </Grid>
</Window>
