<UserControl x:Class="AvasRoutingApp.Views.OverlaySidebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:views="clr-namespace:AvasRoutingApp.Views"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="380">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        <Style x:Key="SidebarActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeButtonBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeButtonForegroundBrush}" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Margin" Value="0,0,8,6" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeButtonBorderBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="5" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource ThemeButtonHoverBackgroundBrush}" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource ThemeButtonHoverBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource ThemeAccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource ThemeAccentForegroundBrush}" />
                                <Setter TargetName="Border" Property="Opacity" Value="0.9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource ThemeSidebarBackgroundBrush}" HorizontalAlignment="Stretch">
        <Grid.LayoutTransform>
            <ScaleTransform ScaleX="{Binding SidebarFontScale, FallbackValue=1.0}" ScaleY="{Binding SidebarFontScale, FallbackValue=1.0}" />
        </Grid.LayoutTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Sidebar Header: Segmented Tabs, Title, Controls, Telemetry Summary -->
        <Border Grid.Row="0" Background="{DynamicResource ThemeHeaderBackgroundBrush}" BorderBrush="{DynamicResource ThemeHeaderBorderBrush}" BorderThickness="0,0,0,1" Padding="14,12">
            <StackPanel>
                <!-- Top Bar with Segmented Tabs and Collapse Button -->
                <DockPanel Margin="0,0,0,10">
                    <!-- Collapse Chevron Button -->
                    <Button DockPanel.Dock="Right" 
                            Click="BtnCloseSidebar_Click" 
                            Width="38" Height="38" 
                            Margin="8,0,0,0" 
                            Background="Transparent" 
                            BorderThickness="1" 
                            BorderBrush="{DynamicResource ThemeCardBorderBrush}" 
                            Cursor="Hand" 
                            ToolTip="Collapse Sidebar (Ctrl+B)">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                    <Path Data="{DynamicResource IconGeometryChevronRight}" Fill="{DynamicResource ThemeTextSecondaryBrush}" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Navigation Segmented Tabs (Live Previews vs Multi-Link vs Thermals) -->
                    <Border Background="{DynamicResource ThemePillBackgroundBrush}" BorderBrush="{DynamicResource ThemeCardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="3">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Tab 1: Live Previews -->
                            <Button Grid.Column="0" 
                                    Command="{Binding SelectPreviewsTabCommand}"
                                    Height="36" 
                                    FontSize="11" 
                                    FontWeight="Bold" 
                                    Cursor="Hand"
                                    BorderThickness="0"
                                    ToolTip="Live Preview Streams">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="{DynamicResource ThemeTabInactiveForegroundBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPreviewsTabSelected}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource ThemeTabActiveBackgroundBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource ThemeTabActiveForegroundBrush}" />
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Opacity" Value="0.9" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter Property="Opacity" Value="0.75" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Path Data="{DynamicResource IconGeometryPreviews}" Fill="{TemplateBinding Foreground}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Previews" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Tab 2: Multi-Link Manager -->
                            <Button Grid.Column="1" 
                                    Command="{Binding SelectMultiLinkTabCommand}"
                                    Height="36" 
                                    FontSize="11" 
                                    FontWeight="Bold" 
                                    Cursor="Hand"
                                    BorderThickness="0"
                                    ToolTip="Multi-Link 10G/20G Topology">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="{DynamicResource ThemeTabInactiveForegroundBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMultiLinkTabSelected}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource ThemeTabActiveBackgroundBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource ThemeTabActiveForegroundBrush}" />
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Opacity" Value="0.9" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter Property="Opacity" Value="0.75" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Path Data="{DynamicResource IconGeometryMultiLink}" Fill="{TemplateBinding Foreground}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Multi-Link" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Tab 3: Thermals (Device Temperatures) -->
                            <Button Grid.Column="2" 
                                    Command="{Binding SelectTemperatureTabCommand}"
                                    Height="36" 
                                    FontSize="11" 
                                    FontWeight="Bold" 
                                    Cursor="Hand"
                                    BorderThickness="0"
                                    ToolTip="Device Temperatures (TX &amp; RX Junctions)">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="{DynamicResource ThemeTabInactiveForegroundBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTemperatureTabSelected}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource ThemeTabActiveBackgroundBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource ThemeTabActiveForegroundBrush}" />
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Opacity" Value="0.9" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter Property="Opacity" Value="0.75" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Path Data="{DynamicResource IconGeometryTemperature}" Fill="{TemplateBinding Foreground}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Thermals" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
                                                <!-- Critical Temperature Warning Indicator -->
                                                <Border Background="#EF4444" 
                                                        CornerRadius="6" 
                                                        Width="13" Height="13" 
                                                        Margin="4,0,0,0" 
                                                        VerticalAlignment="Center"
                                                        ToolTip="Critical Junction Temperature (> 70°C) Detected!"
                                                        Visibility="{Binding HasAnyCriticalTemperature, Converter={StaticResource BoolToVisConverter}}">
                                                    <TextBlock Text="!" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>
                </DockPanel>

                <!-- Header Content for Previews Tab -->
                <StackPanel Visibility="{Binding IsPreviewsTabSelected, Converter={StaticResource BoolToVisConverter}}">
                    <DockPanel>
                        <TextBlock Text="AVAS-223 TX PREVIEWS" FontWeight="Bold" Foreground="{DynamicResource ThemeAccentBrush}" FontSize="13" VerticalAlignment="Center" />
                        <Border DockPanel.Dock="Right" HorizontalAlignment="Right" Background="{DynamicResource ThemePillBackgroundBrush}" CornerRadius="4" Padding="6,2">
                            <TextBlock Text="chip_0 only" Foreground="{DynamicResource ThemeTextSecondaryBrush}" FontSize="10" FontWeight="SemiBold" />
                        </Border>
                    </DockPanel>

                    <TextBlock Text="Strict Filter: VID 105, PID 81, chip_0" Foreground="{DynamicResource ThemeTextMutedBrush}" FontSize="10" Margin="0,2,0,8" />

                    <!-- Action Toolbar: Discover / Refresh, Start All, Stop All -->
                    <WrapPanel Margin="0,0,0,6">
                        <Button Command="{Binding RefreshDevicesCommand}" Style="{StaticResource SidebarActionButtonStyle}" ToolTip="Discover and restart encoder preview streams (F5)">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{DynamicResource IconGeometryRefresh}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Text="Discover" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding StopAllStreamsCommand}" Style="{StaticResource SidebarActionButtonStyle}" ToolTip="Stop all active preview streams">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{DynamicResource IconGeometryStop}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="10" Height="10" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Text="Stop All" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding StartAllStreamsCommand}" Style="{StaticResource SidebarActionButtonStyle}" ToolTip="Start streaming all discovered encoders">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{DynamicResource IconGeometryPlay}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="10" Height="10" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Text="Start All" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <!-- Stream & Multicast Telemetry Summary -->
                    <Border Background="{DynamicResource ThemeCardHeaderBackgroundBrush}" CornerRadius="4" Padding="8,5" Margin="0,2,0,0" BorderThickness="1" BorderBrush="{DynamicResource ThemeCardBorderBrush}">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="Active Encoders:" Foreground="{DynamicResource ThemeTextSecondaryBrush}" FontSize="11" />
                                <TextBlock HorizontalAlignment="Right" Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontWeight="SemiBold" FontSize="11">
                                    <Run Text="{Binding ActiveStreamCount, Mode=OneWay}" Foreground="{DynamicResource ThemeStatusOnlineBrush}" />
                                    <Run Text=" / " />
                                    <Run Text="{Binding DiscoveredEncoderCount, Mode=OneWay}" />
                                </TextBlock>
                            </DockPanel>
                            <TextBlock Text="{Binding MulticastPoolRangeText, Mode=OneWay}" Foreground="{DynamicResource ThemeTextMutedBrush}" FontSize="10" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Header Content for Multi-Link Tab -->
                <StackPanel Visibility="{Binding IsMultiLinkTabSelected, Converter={StaticResource BoolToVisConverter}}">
                    <DockPanel>
                        <TextBlock Text="MULTI-LINK TOPOLOGY" FontWeight="Bold" Foreground="{DynamicResource ThemeAccentBrush}" FontSize="13" VerticalAlignment="Center" />
                        <Border DockPanel.Dock="Right" HorizontalAlignment="Right" Background="{DynamicResource ThemePillBackgroundBrush}" CornerRadius="4" Padding="6,2">
                            <TextBlock Text="10G / 20G Mode" Foreground="{DynamicResource ThemeTextSecondaryBrush}" FontSize="10" FontWeight="SemiBold" />
                        </Border>
                    </DockPanel>

                    <TextBlock Text="Manage Single/Dual link and monitor companion chips" Foreground="{DynamicResource ThemeTextMutedBrush}" FontSize="10" Margin="0,2,0,8" />

                    <!-- Action Toolbar: Refresh MultiLink -->
                    <WrapPanel Margin="0,0,0,6">
                        <Button Command="{Binding RefreshDevicesCommand}" Style="{StaticResource SidebarActionButtonStyle}" ToolTip="Re-query multi-link topology and companion status (F5)">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{DynamicResource IconGeometryRefresh}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Text="Refresh Topology" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <!-- Multi-Link Telemetry Summary -->
                    <Border Background="{DynamicResource ThemeCardHeaderBackgroundBrush}" CornerRadius="4" Padding="8,5" Margin="0,2,0,0" BorderThickness="1" BorderBrush="{DynamicResource ThemeCardBorderBrush}">
                        <DockPanel>
                            <TextBlock Text="TX Pairs Configured:" Foreground="{DynamicResource ThemeTextSecondaryBrush}" FontSize="11" />
                            <TextBlock HorizontalAlignment="Right" Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontWeight="SemiBold" FontSize="11">
                                <Run Text="{Binding MultiLinkCards.Count, Mode=OneWay}" Foreground="{DynamicResource ThemeAccentBrush}" />
                                <Run Text=" pair(s)" />
                            </TextBlock>
                        </DockPanel>
                    </Border>
                </StackPanel>

                <!-- Header Content for Temperature Tab -->
                <StackPanel Visibility="{Binding IsTemperatureTabSelected, Converter={StaticResource BoolToVisConverter}}">
                    <DockPanel>
                        <TextBlock Text="DEVICE TEMPERATURES" FontWeight="Bold" Foreground="{DynamicResource ThemeAccentBrush}" FontSize="13" VerticalAlignment="Center" />
                        <Border DockPanel.Dock="Right" HorizontalAlignment="Right" Background="{DynamicResource ThemePillBackgroundBrush}" CornerRadius="4" Padding="6,2">
                            <TextBlock Text="TX &amp; RX / Chip 0 &amp; 1" Foreground="{DynamicResource ThemeTextSecondaryBrush}" FontSize="10" FontWeight="SemiBold" />
                        </Border>
                    </DockPanel>

                    <TextBlock Text="SDVoE REST API vs Advantech VoIP SDK Junction Telemetry" Foreground="{DynamicResource ThemeTextMutedBrush}" FontSize="10" Margin="0,2,0,8" />

                    <!-- Sub-Filter Segmented Buttons: All / TX / RX & Refresh Button -->
                    <DockPanel Margin="0,0,0,8">
                        <Border Background="{DynamicResource ThemePillBackgroundBrush}" BorderBrush="{DynamicResource ThemeCardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="2" DockPanel.Dock="Left">
                            <StackPanel Orientation="Horizontal">
                                <!-- All Filter Button -->
                                <Button Command="{Binding SetFilterAllCommand}" Padding="8,3" Height="26" Cursor="Hand" BorderThickness="0">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFilterAllSelected}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource ThemeTabActiveBackgroundBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource ThemeTabActiveForegroundBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                <TextBlock FontSize="10" FontWeight="SemiBold">
                                                    <Run Text="All (" /><Run Text="{Binding TotalTemperatureDeviceCount, Mode=OneWay}" /><Run Text=")" />
                                                </TextBlock>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!-- TX Filter Button -->
                                <Button Command="{Binding SetFilterTxCommand}" Padding="8,3" Height="26" Cursor="Hand" BorderThickness="0" Margin="2,0,0,0">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFilterTxSelected}" Value="True">
                                                    <Setter Property="Background" Value="#3B82F6" />
                                                    <Setter Property="Foreground" Value="White" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                <TextBlock FontSize="10" FontWeight="SemiBold">
                                                    <Run Text="TX (" /><Run Text="{Binding TxTemperatureCount, Mode=OneWay}" /><Run Text=")" />
                                                </TextBlock>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!-- RX Filter Button -->
                                <Button Command="{Binding SetFilterRxCommand}" Padding="8,3" Height="26" Cursor="Hand" BorderThickness="0" Margin="2,0,0,0">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFilterRxSelected}" Value="True">
                                                    <Setter Property="Background" Value="#8B5CF6" />
                                                    <Setter Property="Foreground" Value="White" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                <TextBlock FontSize="10" FontWeight="SemiBold">
                                                    <Run Text="RX (" /><Run Text="{Binding RxTemperatureCount, Mode=OneWay}" /><Run Text=")" />
                                                </TextBlock>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Refresh Button -->
                        <Button DockPanel.Dock="Right" HorizontalAlignment="Right"
                                Command="{Binding RefreshTemperaturesCommand}" 
                                Style="{StaticResource SidebarActionButtonStyle}" 
                                Padding="10,4" 
                                MinHeight="26" 
                                Margin="0"
                                ToolTip="Query junction temperatures from SDVoE API and VoIP SDK (F5)">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{DynamicResource IconGeometryRefresh}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="10" Height="10" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center" />
                                <TextBlock Text="Refresh" VerticalAlignment="Center" FontSize="10" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </DockPanel>

                    <!-- Temperature Telemetry & Auto-poll Summary -->
                    <Border Background="{DynamicResource ThemeCardHeaderBackgroundBrush}" CornerRadius="4" Padding="8,5" Margin="0,2,0,0" BorderThickness="1" BorderBrush="{DynamicResource ThemeCardBorderBrush}">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding LastTemperatureUpdatedText, Mode=OneWay}" Foreground="{DynamicResource ThemeTextMutedBrush}" FontSize="10" VerticalAlignment="Center" />
                                <TextBlock Text=" • 5s Auto-poll" Foreground="{DynamicResource ThemeTextMutedBrush}" FontSize="10" VerticalAlignment="Center" Margin="4,0,0,0" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <!-- Critical Alert Badge if any -->
                                <Border Background="#33EF4444" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="0,0,6,0"
                                        Visibility="{Binding HasAnyCriticalTemperature, Converter={StaticResource BoolToVisConverter}}">
                                    <TextBlock Foreground="#EF4444" FontSize="9" FontWeight="Bold">
                                        <Run Text="{Binding CriticalTemperatureCount, Mode=OneWay}" /><Run Text=" >70°C alert" />
                                    </TextBlock>
                                </Border>
                                
                                <TextBlock Foreground="{DynamicResource ThemeTextSecondaryBrush}" FontSize="10" VerticalAlignment="Center">
                                    <Run Text="Threshold: " />
                                    <Run Text=">70°C" FontWeight="Bold" Foreground="#EF4444" />
                                </TextBlock>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Sidebar Body: Scrollable Content with Virtualization and Touch Panning -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12" CanContentScroll="True" PanningMode="VerticalOnly" IsDeferredScrollingEnabled="False">
            <Grid>
                <!-- View 1: Previews Tab Content -->
                <StackPanel Visibility="{Binding IsPreviewsTabSelected, Converter={StaticResource BoolToVisConverter}}">
                    <!-- Empty State Notice for Previews -->
                    <Border Background="{DynamicResource ThemeCardBackgroundBrush}" CornerRadius="6" Padding="16" Margin="0,12,0,0" BorderBrush="{DynamicResource ThemeCardBorderBrush}" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EncoderCards.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center">
                            <Path Data="{DynamicResource IconGeometrySignal}" Fill="{DynamicResource ThemeTextMutedBrush}" Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,8" />
                            <TextBlock Text="No active AVAS-223 chip_0 streams" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontSize="12" HorizontalAlignment="Center" />
                            <TextBlock Text="Click 'Discover' to scan the SDVoE Control Server for connected encoders." Foreground="{DynamicResource ThemeTextMutedBrush}" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Preview Cards Collection (Virtualizing for high performance) -->
                    <ItemsControl ItemsSource="{Binding EncoderCards}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <views:EncoderCardView />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- View 2: Multi-Link Tab Content -->
                <StackPanel Visibility="{Binding IsMultiLinkTabSelected, Converter={StaticResource BoolToVisConverter}}">
                    <!-- Empty State Notice for Multi-Link -->
                    <Border Background="{DynamicResource ThemeCardBackgroundBrush}" CornerRadius="6" Padding="16" Margin="0,12,0,0" BorderBrush="{DynamicResource ThemeCardBorderBrush}" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MultiLinkCards.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center">
                            <Path Data="{DynamicResource IconGeometryMultiLink}" Fill="{DynamicResource ThemeTextMutedBrush}" Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,8" />
                            <TextBlock Text="No AVAS-223 TX Encoders Detected" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontSize="12" HorizontalAlignment="Center" />
                            <TextBlock Text="Click 'Refresh Topology' to query device configurations." Foreground="{DynamicResource ThemeTextMutedBrush}" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Multi-Link Cards Collection (Virtualizing) -->
                    <ItemsControl ItemsSource="{Binding MultiLinkCards}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <views:MultiLinkCardView />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- View 3: Temperature Tab Content -->
                <StackPanel Visibility="{Binding IsTemperatureTabSelected, Converter={StaticResource BoolToVisConverter}}">
                    <!-- Empty State Notice for Temperature -->
                    <Border Background="{DynamicResource ThemeCardBackgroundBrush}" CornerRadius="6" Padding="16" Margin="0,12,0,0" BorderBrush="{DynamicResource ThemeCardBorderBrush}" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TemperatureCards.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center">
                            <Path Data="{DynamicResource IconGeometryTemperature}" Fill="{DynamicResource ThemeTextMutedBrush}" Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,8" />
                            <TextBlock Text="No Temperature Readings Available" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontSize="12" HorizontalAlignment="Center" />
                            <TextBlock Text="Click 'Refresh' to query SDVoE API and VoIP SDK for encoder/decoder junction temperatures." Foreground="{DynamicResource ThemeTextMutedBrush}" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Group 1: TX Encoders Section -->
                    <StackPanel Visibility="{Binding ShowTxSection, Converter={StaticResource BoolToVisConverter}}" Margin="0,0,0,10">
                        <!-- Collapsible Section Header for TX -->
                        <Border Background="{DynamicResource ThemeCardHeaderBackgroundBrush}" BorderBrush="{DynamicResource ThemeCardBorderBrush}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,6" Padding="10,6">
                            <Button Command="{Binding ToggleTxSectionCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="0" HorizontalContentAlignment="Stretch">
                                <DockPanel LastChildFill="True">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                        <Border Background="#3B82F6" CornerRadius="3" Padding="5,1" Margin="0,0,6,0">
                                            <TextBlock Text="TX" Foreground="White" FontSize="9" FontWeight="Bold" />
                                        </Border>
                                        <TextBlock Text="ENCODERS" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontSize="11" VerticalAlignment="Center" />
                                        <Border Background="{DynamicResource ThemePillBackgroundBrush}" CornerRadius="8" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FilteredTxCards.Count, Mode=OneWay}" Foreground="{DynamicResource ThemeTextSecondaryBrush}" FontSize="10" FontWeight="SemiBold" />
                                        </Border>
                                    </StackPanel>
                                    <Path DockPanel.Dock="Right" HorizontalAlignment="Right" Width="10" Height="10" Stretch="Uniform" Fill="{DynamicResource ThemeTextSecondaryBrush}" VerticalAlignment="Center">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Data" Value="{DynamicResource IconGeometryChevronDown}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsTxSectionExpanded}" Value="False">
                                                        <Setter Property="Data" Value="{DynamicResource IconGeometryChevronRight}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </DockPanel>
                            </Button>
                        </Border>

                        <!-- TX Cards List -->
                        <ItemsControl ItemsSource="{Binding FilteredTxCards}" 
                                      Visibility="{Binding IsTxSectionExpanded, Converter={StaticResource BoolToVisConverter}}"
                                      VirtualizingPanel.IsVirtualizing="True" 
                                      VirtualizingPanel.VirtualizationMode="Recycling">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <views:DeviceTemperatureCardView />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Group 2: RX Decoders Section -->
                    <StackPanel Visibility="{Binding ShowRxSection, Converter={StaticResource BoolToVisConverter}}">
                        <!-- Collapsible Section Header for RX -->
                        <Border Background="{DynamicResource ThemeCardHeaderBackgroundBrush}" BorderBrush="{DynamicResource ThemeCardBorderBrush}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,6" Padding="10,6">
                            <Button Command="{Binding ToggleRxSectionCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="0" HorizontalContentAlignment="Stretch">
                                <DockPanel LastChildFill="True">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                        <Border Background="#8B5CF6" CornerRadius="3" Padding="5,1" Margin="0,0,6,0">
                                            <TextBlock Text="RX" Foreground="White" FontSize="9" FontWeight="Bold" />
                                        </Border>
                                        <TextBlock Text="DECODERS" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontSize="11" VerticalAlignment="Center" />
                                        <Border Background="{DynamicResource ThemePillBackgroundBrush}" CornerRadius="8" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FilteredRxCards.Count, Mode=OneWay}" Foreground="{DynamicResource ThemeTextSecondaryBrush}" FontSize="10" FontWeight="SemiBold" />
                                        </Border>
                                    </StackPanel>
                                    <Path DockPanel.Dock="Right" HorizontalAlignment="Right" Width="10" Height="10" Stretch="Uniform" Fill="{DynamicResource ThemeTextSecondaryBrush}" VerticalAlignment="Center">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Data" Value="{DynamicResource IconGeometryChevronDown}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRxSectionExpanded}" Value="False">
                                                        <Setter Property="Data" Value="{DynamicResource IconGeometryChevronRight}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </DockPanel>
                            </Button>
                        </Border>

                        <!-- RX Cards List -->
                        <ItemsControl ItemsSource="{Binding FilteredRxCards}" 
                                      Visibility="{Binding IsRxSectionExpanded, Converter={StaticResource BoolToVisConverter}}"
                                      VirtualizingPanel.IsVirtualizing="True" 
                                      VirtualizingPanel.VirtualizationMode="Recycling">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <views:DeviceTemperatureCardView />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Sidebar Footer: Status bar -->
        <Border Grid.Row="2" Background="{DynamicResource ThemeStatusBarBackgroundBrush}" BorderBrush="{DynamicResource ThemeStatusBarBorderBrush}" BorderThickness="0,1,0,0" Padding="10,6">
            <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource ThemeTextMutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</UserControl>
