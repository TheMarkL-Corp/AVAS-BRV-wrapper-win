<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>AvasRoutingSetup</AssemblyName>
    <RootNamespace>AvasRoutingSetup</RootNamespace>
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <InformationalVersion>1.1.0</InformationalVersion>
    <ApplicationIcon>Assets\logo.ico</ApplicationIcon>
    <Product>AVAS Routing Software Setup</Product>
    <Company>Advantech Co., Ltd.</Company>
    <Description>AVAS Routing Software Package Installer with Zero-Internet Dependency Installation and Advantech White-Labeling</Description>
    <Copyright>Copyright © 2026 Advantech Co., Ltd. All rights reserved.</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\logo.ico" />
  </ItemGroup>

</Project>
